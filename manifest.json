{
  "manifest_version": 3,
  "name": "URL & Title Keyword Filter",
  "version": "1.0",
  "description": "Detect NG keywords and close tab.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}

